# Map for WebSocket upgrade — "" by default, "upgrade" when client requests it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _server;

    root /var/www/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }

    # API + WebSocket pass-through to the Node backend.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for /api/v1/robot/
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Telemetry connections can sit idle between frames; keep them open.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

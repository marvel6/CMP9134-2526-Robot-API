NODE_ENV=development
PORT=8000
JWT_SECRET_KEY=please-change-me-in-production

MONGODB_URI=mongodb://localhost:27017/robocontrol
REDIS_URL=redis://localhost:6379/0
BASE_ROBOT_API_URL=http://localhost:5555

CORS_ORIGINS=*

# Created on first boot if it doesn't exist. Log in as a COMMANDER and
# you can move the robot and view the audit log immediately.
DEFAULT_COMMANDER_EMAIL=commander@robocontrol.local
DEFAULT_COMMANDER_PASSWORD=commander123
DEFAULT_COMMANDER_NAME=Default Commander
